{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "provider": "Static",
  "collectionRoot": "__USERPROFILE__/Pictures/Wallpapers",
  "collections": [
    {
      "name": "Default",
      "path": "__USERPROFILE__/Pictures/Wallpapers",
      "provider": "Static"
    }
  ],
  "workspaceMapping": {
    "1": { "provider": "Static", "collection": "Default" },
    "2": { "provider": "Static", "collection": "Default" },
    "3": { "provider": "Static", "collection": "Default" },
    "4": { "provider": "Static", "collection": "Default" },
    "5": { "provider": "Static", "collection": "Default" },
    "6": { "provider": "Static", "collection": "Default" },
    "7": { "provider": "Static", "collection": "Default" },
    "8": { "provider": "Static", "collection": "Default" },
    "9": { "provider": "Static", "collection": "Default" }
  },
  "favorites": [],
  "ui": {
    "position": "right",
    "width": 420,
    "acrylic": true,
    "autoHideOnFocusLost": true,
    "closeOnOutsideClick": true,
    "animation": true
  },
  "debounceMs": 350,
  "historyLimit": 50,
  "autoStartWatcher": true
}
