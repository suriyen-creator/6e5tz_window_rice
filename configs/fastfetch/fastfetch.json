{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "key": {
      "width": 12
    },
    "separator": " "
  },
  "logo": {
    "type": "file",
    "source": "__USERPROFILE__/fastfetch/frieren.txt",
    "color": {
      "1": "#ccccff",
      "2": "#c6d2ff",
      "3": "#c1d7ff",
      "4": "#bedcff",
      "5": "#bde0fe"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": "󰀉 USER",
      "keyColor": "#ccccff",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "separator",
      "string": "─────────────────────────",
      "outputColor": "#89b4fa"
    },
    {
      "type": "os",
      "key": "󰍲 OS",
      "keyColor": "#c9cfff"
    },
    {
      "type": "host",
      "key": "󰌢 HOST",
      "keyColor": "#c7d1ff"
    },
    {
      "type": "kernel",
      "key": "󰌽 KER",
      "keyColor": "#c4d4ff"
    },
    {
      "type": "uptime",
      "key": "󰥔 UP",
      "keyColor": "#c2d6ff"
    },
    {
      "type": "packages",
      "key": "󰏖 PKG",
      "keyColor": "#c1d7ff"
    },
    {
      "type": "shell",
      "key": "󰞷 SH",
      "keyColor": "#c0d9ff",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "display",
      "key": "󰍹 DISP",
      "keyColor": "#bedbff",
      "format": "{width}x{height} @ {refresh-rate}Hz"
    },
    {
      "type": "wm",
      "key": "󱂬 WM",
      "keyColor": "#bddcff",
      "format": "{plugin-name}"
    },
    {
      "type": "terminal",
      "key": "󰆍 TERM",
      "keyColor": "#bddeff",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "keyColor": "#bde0fe"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "#bde0fe"
    },
    {
      "type": "memory",
      "key": "󰍛 RAM",
      "keyColor": "#bde0fe",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "󰋊 DISK",
      "keyColor": "#bde0fe",
      "folders": "C:\\",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "battery",
      "key": "󰁹 BAT",
      "keyColor": "#bde0fe"
    },
    {
      "type": "custom",
      "format": "\u001b[90m \u001b[91m \u001b[92m \u001b[93m \u001b[94m \u001b[95m \u001b[96m \u001b[97m"
    },
    "break"
  ]
}
